{
  "name": "react-realtime-drawing",
  "version": "0.1.4",
  "homepage": "https://jsaari97.github.io/react-realtime-drawing",
  "description": "Realtime canvas drawing hooks for React",
  "author": "jsaari97",
  "license": "MIT",
  "repository": "jsaari97/react-realtime-drawing",
  "main": "dist/index.js",
  "module": "dist/index.modern.js",
  "source": "src/index.tsx",
  "keywords": [
    "react",
    "realtime",
    "canvas",
    "drawing",
    "hooks"
  ],
  "scripts": {
    "build": "microbundle-crl --no-compress --format modern,cjs",
    "start": "microbundle-crl watch --no-compress --format modern,cjs",
    "prepublish": "run-s build",
    "test": "run-s test:unit test:lint test:build",
    "test:build": "run-s build",
    "test:lint": "eslint .",
    "test:unit": "cross-env CI=1 react-scripts test",
    "test:watch": "react-scripts test",
    "predeploy": "cd example && npm install && npm run build",
    "deploy": "gh-pages -d example/build"
  },
  "peerDependencies": {
    "react": "^16.8.0 || ^17.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/react": "^12.0.0",
    "@testing-library/react-hooks": "^7.0.0",
    "@types/jest": "^27.0.0",
    "@types/react": "^17.0.0",
    "cross-env": "^7.0.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "gh-pages": "^3.0.0",
    "globals": "^17.4.0",
    "jest-canvas-mock": "^2.2.0",
    "microbundle-crl": "^0.13.10",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1",
    "react": "^17.0.0",
    "react-dom": "^17.0.0",
    "react-scripts": "^5.0.0",
    "typescript-eslint": "^8.46.3"
  },
  "files": [
    "dist"
  ]
}
