{
  "name": "react-realtime-drawing",
  "version": "0.2.0",
  "homepage": "https://jsaari97.github.io/react-realtime-drawing",
  "description": "Realtime canvas drawing hooks for React",
  "author": "jsaari97",
  "license": "MIT",
  "repository": "jsaari97/react-realtime-drawing",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "source": "src/index.tsx",
  "keywords": [
    "react",
    "realtime",
    "canvas",
    "drawing",
    "hooks"
  ],
  "scripts": {
    "build": "tsdown src/index.tsx --format esm,cjs --dts --out-dir dist --sourcemap --clean --platform browser",
    "start": "tsdown src/index.tsx --format esm,cjs --dts --out-dir dist --sourcemap --platform browser --watch",
    "example:start": "npm --prefix example run start",
    "prepublish": "run-s build",
    "test": "run-s test:unit test:lint test:build",
    "test:build": "run-s build",
    "test:lint": "eslint .",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "predeploy": "npm --prefix example ci && npm --prefix example run build",
    "deploy": "gh-pages -d example/dist"
  },
  "peerDependencies": {
    "react": "^16.14.0 || ^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "gh-pages": "^6.3.0",
    "globals": "^17.4.0",
    "jest-canvas-mock": "^2.2.0",
    "jsdom": "^30.0.1",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^8.0.5",
    "vitest": "^4.0.18"
  },
  "files": [
    "dist"
  ]
}
